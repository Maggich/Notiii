# Copy to .env only if you need to override the local Docker Compose defaults.
# These development credentials are not suitable for production.
POSTGRES_DB=music_sheet_library
POSTGRES_USER=music_sheet_user
POSTGRES_PASSWORD=local-dev-only-change-me
DJANGO_SECRET_KEY=local-only-change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
